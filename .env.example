# --- database (SQLite for local dev / sandbox; Neon Postgres URL for Vercel prod) ---
DATABASE_URL="file:../db/unicom.db"

# --- credential encryption (C1) ---
# 32-byte key as 64 hex chars. Generate: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=""

# --- commander LLM driver (C2) ---
# zai     = z-ai-web-dev-sdk (server-side only)
# openrouter = OpenRouter REST (works anywhere, incl. Vercel)
# none    = offline template mode (agent still answers with honest "offline" plans)
LLM_DRIVER="zai"
OPENROUTER_API_KEY=""

# --- optional OAuth apps for real (non-key) platform connect flows ---
# SHOPIFY_CLIENT_ID=""
# SHOPIFY_CLIENT_SECRET=""
# ETSY_KEYSTRING=""
# ETSY_CLIENT_ID=""
# ETSY_CLIENT_SECRET=""
